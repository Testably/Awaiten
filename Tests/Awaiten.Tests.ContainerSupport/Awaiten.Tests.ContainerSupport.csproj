<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>library</OutputType>
		<IsTestProject>false</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- A plain support library referenced by Awaiten.Tests that plays a production assembly: it declares a
	     [Container] that a test container in Awaiten.Tests extends across the assembly boundary. Kept apart from
	     Awaiten.Tests.Support, because an assembly that declares a [Container] is a composition root, for which the
	     boundary analyzer does not report AWT134. Not a test project. -->
	<ItemGroup>
		<PackageReference Remove="TUnit.Engine" />
		<PackageReference Remove="Microsoft.Testing.Extensions.TrxReport" />
		<PackageReference Remove="Microsoft.Testing.Extensions.CodeCoverage" />
		<PackageReference Remove="aweXpect" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Awaiten.SourceGenerators\Awaiten.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\Source\Awaiten\Awaiten.csproj" />
		<ProjectReference Include="..\Awaiten.Tests.Support\Awaiten.Tests.Support.csproj" />
	</ItemGroup>

</Project>
