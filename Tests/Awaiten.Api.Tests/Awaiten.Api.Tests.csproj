<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Awaiten\Awaiten.csproj"/>
		<ProjectReference Include="..\..\Source\Awaiten.Extensions.DependencyInjection\Awaiten.Extensions.DependencyInjection.csproj"/>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="aweXpect.Snapshots.PublicApi"/>
		<!-- Carried so the dependency assemblies of Awaiten.Extensions.DependencyInjection land in this test's
		     output, where the public API resolves the references of the assemblies. -->
		<PackageReference Include="Microsoft.Extensions.DependencyInjection"/>
		<!-- The netstandard2.0 build of Awaiten.Extensions.DependencyInjection references this version, which the runtime of the tests does not provide. -->
		<PackageReference Include="Microsoft.Bcl.AsyncInterfaces"/>
	</ItemGroup>

	<!--
	    The tests read the builds of all target frameworks of the referenced projects, but a project reference only
	    builds the one that matches the tests. Without the target framework, the same builds as in the solution are
	    requested, which MSBuild runs only once; DispatchToInnerBuilds builds them without packing.
	-->
	<Target Name="BuildAllTargetFrameworksOfReferencedProjects" AfterTargets="Build">
		<MSBuild Projects="@(ProjectReference)" Targets="DispatchToInnerBuilds" RemoveProperties="TargetFramework"/>
	</Target>
</Project>
