<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- AWT193: the ScanTests fixture deliberately keeps an internal ICrossAssemblyPlugin in the referenced
		     support assembly, so the cross-assembly scans here can pin that it is not registered. A "!InternalPlugin"
		     NamePatterns entry would silence the warning, but it would also make the filter the reason the type is
		     skipped, which is exactly what these scans exist to prove is not the case: it is the accessibility that
		     skips it. Suppressed project-wide because AWT193 is emitted by the source generator. -->
		<NoWarn>$(NoWarn);AWT193</NoWarn>
		<!-- AWT218, AWT219: several tests resolve a service the container does not hand out through that typed call,
		     to pin the run-time exception and its guidance that untyped callers still get. -->
		<NoWarn>$(NoWarn);AWT218;AWT219</NoWarn>
		<!-- AWT158: ModuleInjectedPropertyShapeTests pins that an optional init-only property behaves alike in every container. -->
		<NoWarn>$(NoWarn);AWT158</NoWarn>
		<!-- Awaiten.Tests.ContainerSupport grants this assembly InternalsVisibleTo, so its copy of the Nullable attributes is visible here and a second one would conflict (CS0436). -->
		<DefineConstants>$(DefineConstants);NULLABLE_ATTRIBUTES_DISABLE</DefineConstants>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\..\Source\Awaiten.SourceGenerators\Awaiten.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\Source\Awaiten\Awaiten.csproj" />
		<ProjectReference Include="..\Awaiten.Tests.Support\Awaiten.Tests.Support.csproj" />
		<ProjectReference Include="..\Awaiten.Tests.ContainerSupport\Awaiten.Tests.ContainerSupport.csproj" />
	</ItemGroup>

</Project>
