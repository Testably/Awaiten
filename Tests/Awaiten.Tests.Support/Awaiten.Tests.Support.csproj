<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>library</OutputType>
		<IsTestProject>false</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- A plain support library referenced by Awaiten.Tests so cross-assembly [Scan(InAssembliesOf = ...)]
	     has a referenced assembly with marker-implementing types to discover. Not a test project. -->
	<ItemGroup>
		<PackageReference Remove="xunit.v3" />
		<PackageReference Remove="xunit.runner.visualstudio" />
		<PackageReference Remove="Microsoft.NET.Test.Sdk" />
		<PackageReference Remove="coverlet.collector" />
		<PackageReference Remove="aweXpect" />
	</ItemGroup>

</Project>
