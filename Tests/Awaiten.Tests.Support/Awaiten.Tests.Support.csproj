<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>library</OutputType>
		<IsTestProject>false</IsTestProject>
		<IsPackable>false</IsPackable>
	</PropertyGroup>

	<!-- A plain support library referenced by Awaiten.Tests so cross-assembly [Scan(InAssembliesOf = ...)]
	     has a referenced assembly with marker-implementing types to discover, and so a container in the test
	     assembly can [Import] a [Module] compiled into a real referenced assembly. Not a test project. -->
	<ItemGroup>
		<PackageReference Remove="xunit.v3" />
		<PackageReference Remove="xunit.runner.visualstudio" />
		<PackageReference Remove="Microsoft.NET.Test.Sdk" />
		<PackageReference Remove="coverlet.collector" />
		<PackageReference Remove="aweXpect" />
	</ItemGroup>

	<!-- The Awaiten attributes plus the generator: the container that [Import]s CrossAssemblySupportModule still
	     reads its hand-written registrations from metadata (the generator emits nothing for a [Module] without a
	     [Scan]), but a [Module] that self-compiles a [Scan] (HookedPluginModule) needs the generator to run here so
	     its factories, hook wrappers and [GeneratedScanRegistration] attributes are compiled into this referenced
	     assembly for a cross-assembly consumer to read. AWT134/AWT135 stay quiet: the boundary analyzer exempts a
	     [Module], and no type here injects a resolver. -->
	<ItemGroup>
		<ProjectReference Include="..\..\Source\Awaiten.SourceGenerators\Awaiten.SourceGenerators.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
		<ProjectReference Include="..\..\Source\Awaiten\Awaiten.csproj" />
	</ItemGroup>

</Project>
